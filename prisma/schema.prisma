// Tabôa – Fortalecimento Comunitário
// Visita Pós-Crédito — schema Prisma / PostgreSQL
//
// Convenções:
//  - Valores monetários ficam em CENTAVOS (Int), nunca Float/Decimal.
//  - IDs são cuid(); quando existe um número "de exibição" sequencial
//    (ex.: número do documento da visita), ele fica em campo separado.
//  - Enums em UPPER_SNAKE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usada só pelo Prisma Migrate. Necessária com Supabase/PgBouncer: a URL "pooler"
  // (porta 6543, modo transaction) não suporta os advisory locks que migrations
  // precisam — DIRECT_URL aponta para a conexão direta (porta 5432). Em dev local
  // (sem pooler), DIRECT_URL fica igual a DATABASE_URL (ver scripts/vercel-build.mjs).
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TECNICO
  COORDENADOR
  ADMIN
}

enum VisitaStatus {
  RASCUNHO
  FINALIZADA
}

enum SignatureType {
  TECNICO
  BENEFICIARIO_DESENHO
  BENEFICIARIO_DIGITAL
}

enum AuditAction {
  LOGIN
  LOGIN_FALHOU
  LOGIN_MOBILE
  REFRESH_TOKEN
  LOGOUT
  CRIACAO
  EDICAO
  UPLOAD_FOTO
  UPLOAD_ASSINATURA
  FINALIZACAO
  REVOGACAO
  ATIVACAO
  DESATIVACAO
  EXCLUSAO
}

// ─── Empresas (multi-tenant) ─────────────────────────────────────────────

/// Cada organização-cliente do sistema. Um SUPER_ADMIN (empresaId nulo) cadastra
/// empresas por aqui; todo o resto (usuários, visitas, finalidades, beneficiários)
/// pertence a exatamente uma empresa e nunca vaza para outra.
model Empresa {
  id          String   @id @default(cuid())
  nome        String
  cnpj        String?  @unique
  endereco    String?
  telefone    String?
  logoFileKey String?
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios      User[]
  visitas       Visita[]
  purposes      Purpose[]
  beneficiarios Beneficiario[]
  sequences     DocumentSequence[]
  agendamentos  Agendamento[]
}

// ─── Usuários e autenticação ────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Nulo somente para SUPER_ADMIN (gerencia empresas, não pertence a uma).
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  name         String
  email        String   @unique
  matricula    String?
  passwordHash String
  role         Role     @default(TECNICO)
  active       Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visitasCriadas    Visita[]             @relation("VisitaTecnico")
  visitasFinalizadas Visita[]            @relation("VisitaFinalizadaPor")
  fotosEnviadas     VisitaFoto[]         @relation("FotoUploadedBy")
  assinaturasCriadas VisitaAssinatura[]  @relation("AssinaturaCriadaPor")
  refreshTokens     MobileRefreshToken[]
  auditLogs         AuditLog[]
  agendamentosAtribuidos Agendamento[]   @relation("AgendamentoTecnico")
  agendamentosCriados    Agendamento[]   @relation("AgendamentoCriadoPor")

  @@index([role])
  @@index([empresaId])
}

model MobileRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Beneficiários e finalidades ─────────────────────────────────────────

model Beneficiario {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cpf       String
  nome      String
  endereco  String
  municipio String
  telefone  String?
  /// Coordenadas da propriedade — mesma ideia do pino de localização do Agendamento,
  /// mas aqui fica fixado no cadastro do cliente (independe de haver ou não visita agendada).
  latitude  Float?
  longitude Float?
  /// Finalidade do crédito original que motivou o cadastro (reaproveita a mesma lista
  /// editável usada na etapa 2 do formulário de visita — ver model Purpose).
  finalidadeCreditoId String?
  finalidadeCredito   Purpose? @relation(fields: [finalidadeCreditoId], references: [id], onDelete: SetNull)
  /// Descrição livre quando `finalidadeCredito.isOutro` — mesma ideia do
  /// Visita.outroFinalidadeDescricao.
  finalidadeCreditoOutro String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitas      Visita[]
  agendamentos Agendamento[]

  @@unique([empresaId, cpf])
  @@index([finalidadeCreditoId])
}

/// Agendamento de visita criado pelo ADMIN/COORDENADOR pra um técnico ir a
/// campo — separado da Visita em si (que só existe quando o técnico
/// efetivamente registra a visita, offline-first, pelo app). O status
/// "pendente"/"atendido" é derivado de `visita != null`, não é um campo à parte.
model Agendamento {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  beneficiarioId  String
  beneficiario    Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Restrict)
  nomePropriedade String
  latitude        Float?
  longitude       Float?
  dataAgendada    DateTime?
  observacoes     String?

  tecnicoId String
  tecnico   User   @relation("AgendamentoTecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)

  criadoPorId String
  criadoPor   User   @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visita Visita?

  @@index([empresaId, tecnicoId])
}

/// Lista de finalidades do crédito, editável pelo painel (não é um enum
/// fixo) para que a equipe possa ajustar sem precisar de novo deploy. Cada
/// empresa mantém sua própria lista.
model Purpose {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  label     String
  /// No máximo uma por empresa: marca a opção "Outro" (a única finalidade que
  /// vem com um campo de texto livre para descrever — ver Visita.outroFinalidadeDescricao).
  isOutro   Boolean  @default(false)
  ativo     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitas       VisitaPurpose[]
  beneficiarios Beneficiario[]

  @@index([empresaId, ativo, sortOrder])
}

model VisitaPurpose {
  id        String  @id @default(cuid())
  visitaId  String
  visita    Visita  @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  purposeId String
  purpose   Purpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  @@unique([visitaId, purposeId])
}

/// Contador por (empresa, ano) para gerar o número oficial do documento (VP-2026-000123).
model DocumentSequence {
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  ano       Int
  ultimo    Int     @default(0)

  @@id([empresaId, ano])
}

// ─── Visita ───────────────────────────────────────────────────────────────

model Visita {
  id              String       @id @default(cuid())
  empresaId       String
  empresa         Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  /// UUID gerado no app Android (Room) — chave de idempotência para reenvio.
  clientLocalId   String       @unique
  /// Ex.: "VP-2026-000123" — atribuído apenas na finalização.
  numeroDocumento String?      @unique
  status          VisitaStatus @default(RASCUNHO)

  tecnicoId String
  tecnico   User   @relation("VisitaTecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)

  /// Preenchido quando a visita nasce de um agendamento criado pelo admin
  /// (o técnico tocou "Iniciar visita" na agenda do app). Opcional — visitas
  /// continuam podendo ser criadas do zero em campo, sem agendamento prévio.
  agendamentoId String?      @unique
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  beneficiarioId String
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Restrict)
  // Snapshot dos dados do beneficiário no momento da visita — não muda
  // retroativamente se o cadastro do beneficiário for editado depois.
  beneficiarioNomeSnapshot     String
  beneficiarioCpfSnapshot      String
  beneficiarioEnderecoSnapshot String

  municipio  String
  dataVisita DateTime

  /// Pergunta 5 — itens detalhados da proposta original do crédito (texto livre).
  finalidadeDetalhada String

  /// Pergunta 7 — está aplicando o recurso conforme a finalidade da proposta?
  aplicandoConforme              Boolean
  aplicandoConformeJustificativa String?

  /// Pergunta 8 (parte "Outro") — descrição livre quando a finalidade "Outro" é marcada.
  outroFinalidadeDescricao String?

  /// Pergunta 9 — teve desafio na aplicação do recurso?
  teveDesafio      Boolean
  desafioDescricao String?

  /// Pergunta 10/11 — assistência técnica após o crédito (periodicidade se sim, motivo se não).
  assistenciaTecnica        Boolean
  assistenciaPeriodicidade  String?
  assistenciaMotivoNegativa String?

  /// Pergunta 12 — nome e contato telefônico do técnico que acompanha (texto livre no
  /// formulário oficial — pode ser diferente do técnico logado no sistema).
  tecnicoNomeContato String

  /// Pergunta 13 — já tem ponto de referência da área financiada?
  pontoReferencia Boolean

  /// Pergunta 15 — observações.
  observacoes String?

  finalizadaEm    DateTime?
  finalizadaPorId String?
  finalizadaPor   User?     @relation("VisitaFinalizadaPor", fields: [finalizadaPorId], references: [id], onDelete: SetNull)
  pdfFileKey      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purposes    VisitaPurpose[]
  fotos       VisitaFoto[]
  assinaturas VisitaAssinatura[]

  @@index([empresaId, dataVisita])
  @@index([tecnicoId, dataVisita])
  @@index([municipio])
  @@index([status])
}

model VisitaFoto {
  id       String @id @default(cuid())
  visitaId String
  visita   Visita @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  /// UUID gerado no app — chave de idempotência do upload da foto.
  clientLocalId String
  fileKey       String
  legenda       String?
  ordem         Int      @default(0)
  uploadedById  String
  uploadedBy    User     @relation("FotoUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@unique([visitaId, clientLocalId])
  @@index([visitaId])
}

model VisitaAssinatura {
  id       String        @id @default(cuid())
  visitaId String
  visita   Visita        @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  tipo     SignatureType
  fileKey  String
  /// Obrigatório quando tipo = BENEFICIARIO_DIGITAL (impressão digital fotografada).
  testemunhaNome String?
  testemunhaCpf  String?
  criadoPorId    String
  criadoPor      User     @relation("AssinaturaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([visitaId, tipo])
  @@index([visitaId])
}

// ─── Auditoria ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  acao       AuditAction
  entidade   String
  entidadeId String
  detalhes   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([entidade, entidadeId])
  @@index([actorId, createdAt])
}

// ─── Infra ─────────────────────────────────────────────────────────────────

/// Rate limiting persistido no banco (funciona entre múltiplas instâncias).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
