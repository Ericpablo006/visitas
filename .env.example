# Conexão PostgreSQL (preenchida automaticamente por `npm run setup` / `npm run db:local`)
DATABASE_URL="postgresql://taboa:taboa@127.0.0.1:5488/taboa?schema=public"
# Usada só pelo Prisma Migrate (conexão direta, sem pooler). Em dev local é igual à
# DATABASE_URL; em produção com Supabase/Neon, aponte para a URL "non-pooling".
DIRECT_URL="postgresql://taboa:taboa@127.0.0.1:5488/taboa?schema=public"

# Assina sessões (cookie) e tokens mobile — gerado por `npm run setup`. >= 32 caracteres aleatórios.
AUTH_SECRET=""
# Segredo separado para tokens de acesso/refresh do app Android (nunca reaproveite o AUTH_SECRET aqui em produção).
MOBILE_AUTH_SECRET=""

# URL pública (sem "/" final) — usada em cookies Secure e links.
APP_URL="http://localhost:3000"

# Super admin (gerencia empresas, não pertence a nenhuma) criado por `npm run db:seed`.
SUPER_ADMIN_EMAIL="super@localhost.dev"
SUPER_ADMIN_PASSWORD=""

# Administrador criado por `npm run db:seed`.
ADMIN_NAME="Administrador Tabôa"
ADMIN_EMAIL="admin@localhost.dev"
ADMIN_PASSWORD=""

# Técnico de exemplo criado por `npm run db:seed`.
TECNICO_NAME="Técnico de Campo"
TECNICO_EMAIL="tecnico@localhost.dev"
TECNICO_PASSWORD=""

# Pasta para arquivos privados (fotos, assinaturas, PDFs). Use um volume persistente em produção.
UPLOAD_DIR="./storage"

# Somente para o docker-compose local (embedded-postgres usa outra credencial).
POSTGRES_PASSWORD=""
